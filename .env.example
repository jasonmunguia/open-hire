# Postgres. Supabase, Neon, or any Postgres works.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler".
# URL-encode special characters in the password (# becomes %23, @ becomes %40).
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Identifies the posting this deployment screens. Any stable string.
JOB_ID="my-job-2026"

# Object storage for resume page images.
# Created by: vercel blob create-store resumes --access public --yes
# That command writes this value into .env.local for you. If it did not:
#   vercel env pull .env.vercel.local   then copy this one line across.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional. JOB_TITLE becomes the browser-tab title (default "Open Hire") and
# the job's title in the database (default "Open Role"). JOB_LABEL is a short
# code stored on the job row (default "ROLE").
JOB_TITLE="Software Engineer Intern"
JOB_LABEL="SWE"

# Interview booking (scripts/book.py). Your scheduling link and who the invite is from.
BOOKING_URL="https://cal.com/you/interview"
SENDER_NAME="Your Name"

# Only for --channel email. Leave unset if you invite over iMessage.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="app-password"
# SMTP_FROM="you@example.com"
