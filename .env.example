# Postgres. Supabase, Neon, or any Postgres works.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler".
# URL-encode special characters in the password (# becomes %23, @ becomes %40).
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Identifies the posting this deployment screens. Any stable string.
JOB_ID="my-job-2026"

# Object storage for resume page images.
# Created by: vercel blob create-store resumes --access public --yes
# That command writes this value into .env.local for you.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
